#!/usr/bin/env bash
# Six gates, all blocking:
#   1. semgrep  — SAST: vendored rules, pinned image, offline (yarn semgrep:ci)
#   2. trivy    — dependency advisories, HIGH+ , production tree only (E18-S11)
#   3. lint     — eslint + prettier --check over the whole tree (yarn lint:check)
#   4. coverage — 100% on every metric (yarn test:cov)
#   5. mutation — 100% mutation score (yarn test:mutation)
#   6. Qodana   — inspections, SAST, license audit, coverage (qodana.yaml)
#
# Coverage proves the lines ran. Mutation proves the assertions actually catch a
# change in them. Qodana proves nothing else regressed — and is the only gate
# that ever sees the merge commit (see gate 6). Neither number may be lowered: if one goes red the fix is a test,
# a deleted dead branch, or — for a provably equivalent mutant — a documented
# `// Stryker disable next-line <Mutator>: <why>`. See COVERAGE.md.
#
# Ahead of all five: node. Every gate shells out to yarn, and `engines.node` is a
# HARD gate under yarn classic — a mismatch exits 1 with `The engine "node" is
# incompatible with this module`, not a warning. Without the switch below, a push
# from a shell on the machine default node dies before the first gate, under
# whatever banner that gate prints, which is never what went wrong.
#
# Enabled by `git config core.hooksPath .githooks`, which the package.json
# `prepare` script sets automatically on `yarn install`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Read the requirement from package.json rather than hard-coding it, so bumping the
# engine in one place cannot leave the hook testing against a version nothing else
# uses. Same block as marketplace-common's pre-commit, which is where it was written.
# The `|| REQUIRED_NODE=''` is load-bearing under `set -euo pipefail`: with no node on PATH the
# substitution exits 127, and `-e` plus `pipefail` then kill the hook right here — silently, with
# no output at all, before the block below can print the one message that would explain it.
# Degrading to empty instead lets node_satisfies() return 1 and the real diagnostic fire.
REQUIRED_NODE="$(node -p 'require("./package.json").engines.node' 2> /dev/null | tr -d '^~>= ')" || REQUIRED_NODE=''

# Empty means node is not on PATH at all — a different failure from the wrong version, and one
# the block below cannot describe: with nothing to interpolate it prints `engines.node ^` and a
# fix line reading `nvm install  && nvm use `, neither of which names anything.
if [ -z "$REQUIRED_NODE" ]; then
	cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — node not found in PATH.

engines.node could not be read from package.json, so the version the gates need
is unknown and nvm has nothing to switch to.

Fix it with:

    nvm install --lts && nvm use --lts

then push again.
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

node_satisfies() {
	local current
	current="$(node -v 2> /dev/null | tr -d 'v')"
	[ -n "$current" ] && [ -n "$REQUIRED_NODE" ] || return 1
	# caret semantics: same major, and not older than the pin.
	[ "${current%%.*}" = "${REQUIRED_NODE%%.*}" ] || return 1
	[ "$(printf '%s\n%s\n' "$REQUIRED_NODE" "$current" | sort -V | head -n 1)" = "$REQUIRED_NODE" ]
}

if ! node_satisfies; then
	# nvm.sh trips over unbound variables, so -u comes off around the source.
	NVM_SH="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
	if [ -s "$NVM_SH" ]; then
		echo "pre-push: node $(node -v 2> /dev/null) does not satisfy engines.node ^$REQUIRED_NODE — switching via nvm."
		set +u
		# shellcheck disable=SC1090
		. "$NVM_SH" > /dev/null 2>&1 || true
		nvm use "$REQUIRED_NODE" > /dev/null 2>&1 || true
		set -u
	fi
fi

if ! node_satisfies; then
	cat >&2 <<MSG

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — wrong node.

node $(node -v 2> /dev/null || echo '(not found)') does not satisfy engines.node ^$REQUIRED_NODE, and nvm could
not be used to switch — either it is not installed at \${NVM_DIR:-\$HOME/.nvm}/nvm.sh
or that version is not installed. yarn refuses to run at all in this state, so
none of the five gates below could report anything.

Fix it with:

    nvm install $REQUIRED_NODE && nvm use $REQUIRED_NODE

then push again.
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

# Every gate below shells out to yarn. Without this check a missing binary is reported as
# whichever gate happened to run first ("eslint or prettier is not clean"), which sends the
# reader after the wrong thing. pre-commit already carries the same check.
if ! command -v yarn > /dev/null 2>&1; then
	cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — yarn not found in PATH.

None of the gates below could run: every one of them shells out to yarn.

Fix it with:

    npm i -g yarn@1.22.22

then push again.
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

# ---------------------------------------------------------------------------
# Gate 1 — Semgrep (SAST). Coverage and mutation ask whether the code is tested;
# this one asks whether it is safe. Deliberately push-only, like mutation: it
# needs Docker and the pinned image, and a hook paid per commit is a hook that
# gets bypassed out of habit. Push is the layer that matters anyway — it is the
# only one that ever sees a merge commit.
#
# It runs FIRST because it is by far the cheapest of the five (~3 s against the
# minutes the rest take together), so a rule violation is reported in seconds
# rather than after a full coverage + mutation + Qodana run.
#
# `semgrep:ci` is the --error variant of `yarn semgrep`: exit 1 on any finding,
# plus a SARIF at semgrep.sarif (gitignored). Every rule is vendored under
# semgrep/ and the container runs --network none, so the verdict is offline and
# reproducible — the pinned image tag is the only moving part.
#
# ⚠️ This is NOT the same scan as Qodana's SAST. Qodana runs JetBrains
# inspections over the whole tree; this runs the semgrep registry packs plus
# semgrep/custom.yml, whose rules are this platform's own — the three
# secret-in-logs guards no general-purpose linter knows about.
#
# Bypass: `SKIP_SEMGREP=1 git push` — for a Docker outage, never for a finding.
# ---------------------------------------------------------------------------

if [ -n "${SKIP_SEMGREP:-}" ]; then
	echo 'pre-push [1/6]: Semgrep gate skipped — SKIP_SEMGREP is set.' >&2
else
	# $1 = what is wrong, $2… = the command(s) that fix it. A missing prerequisite
	# blocks; it never warns and continues. A gate that steps aside when it cannot
	# run is not a gate, it is the hole this hook exists to close, one condition lower.
	semgrep_block() {
		local reason="$1"
		shift
		{
			echo
			echo '────────────────────────────────────────────────────────────────────────────'
			echo "PUSH BLOCKED — $reason"
			echo
			echo 'Fix it with:'
			echo
			printf '    %s\n' "$@"
			echo
			echo 'Bypass once (every other gate still runs): SKIP_SEMGREP=1 git push'
			echo '────────────────────────────────────────────────────────────────────────────'
		} >&2
		exit 1
	}

	# An absent ruleset is not an empty ruleset: `--config semgrep/` on a missing
	# directory is an error, but a half-restored one would scan with whatever
	# survived and report 0 findings, which reads exactly like a pass.
	[ -d semgrep ] ||
		semgrep_block 'semgrep/ is missing from the repo root — every rule this gate runs is vendored there.' \
			'git checkout semgrep'

	command -v docker > /dev/null 2>&1 ||
		semgrep_block 'docker not found in PATH — the scan runs inside the pinned semgrep container.' \
			'# install Docker Engine, then push again:' \
			'https://docs.docker.com/engine/install/'

	docker info > /dev/null 2>&1 ||
		semgrep_block 'docker daemon not reachable.' \
			'sudo systemctl start docker'

	# Read the tag out of the yarn script rather than hard-coding it here, the same
	# way the Qodana gate reads its linter out of qodana.yaml: bumping the engine in
	# one place must not leave this hook checking for an image no scan uses.
	SEMGREP_IMAGE="$(grep -oE 'semgrep/semgrep:[0-9][0-9.]*' package.json | head -n 1 || true)"

	[ -n "$SEMGREP_IMAGE" ] ||
		semgrep_block "no 'semgrep/semgrep:<version>' image found in the package.json scripts." \
			'# restore the semgrep scripts, then push again:' \
			'git checkout package.json'

	# The container would be pulled on demand. Blocking instead keeps a slow or
	# unreachable Docker Hub from turning into a failed push: one explicit pull per
	# image bump, versus a network flake on any push.
	docker image inspect "$SEMGREP_IMAGE" > /dev/null 2>&1 ||
		semgrep_block "semgrep image $SEMGREP_IMAGE is not present locally." \
			"docker pull $SEMGREP_IMAGE"

	echo "pre-push [1/6]: running the SAST gate ($SEMGREP_IMAGE)…"

	if ! yarn semgrep:ci; then
		cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — Semgrep found something, or the scan could not run.

Every finding is printed above and repeated in semgrep.sarif. Read the rule id
first, then the code it matched:

  1. A true positive is fixed in the source, never in the ruleset.
  2. A genuine false positive gets an inline `// nosemgrep: <rule-id>` with the
     reason written on the line above it. Never a bare `// nosemgrep`, which
     silences every rule on that line, and never an edit to semgrep/vendor/ —
     that is a frozen registry snapshot which vendor/refresh.sh will restore.

Re-run `yarn semgrep` for the human-readable report, then push again.
────────────────────────────────────────────────────────────────────────────
MSG
		exit 1
	fi

	echo 'pre-push [1/6]: Semgrep clean.'
fi

# ---------------------------------------------------------------------------
# Gate 2 — Trivy (dependency advisories). Gate 1 asks whether the code this repo
# wrote is safe; this one asks whether the code it installed is. Nothing else on
# the platform answered that question. Qodana's `VulnerableLibrariesLocal` is
# armed in every qodana.yaml, runs on every commit and push, and reports zero
# problems everywhere — because it is a 0.03 s offline heuristic that queries no
# advisory feed at all. `VulnerableLibrariesGlobalInspection`, the class in the
# same image that does call vulnerability-search.jetbrains.com, appears in no
# profile file and in no scan log this workspace has ever produced. A security
# check that cannot report is indistinguishable from a passing one. E18-S11.
#
# Not `yarn audit`: yarn 1 aborts the entire run over the unpublished
# @axiumine/marketplace-common, and `npm audit` needs a package-lock.json this
# workspace does not have. Trivy reads yarn.lock natively.
#
# ⚠️ It suppresses devDependencies by default, and that is the property that makes
# this gate keepable rather than the one everybody learns to bypass: an advisory
# in something only `yarn build` ever loads does not block a push. HIGH and
# CRITICAL only, matching qodana.yaml's own `critical: 0 / high: 0`.
#
# ⚠️ --skip-dirs .stryker-tmp is load-bearing. A crashed mutation run leaves a
# sandbox behind holding a COPY of yarn.lock as it was that day, and trivy reports
# it as a second target with the same weight as the real one. One such sandbox in
# this workspace still carried axios@0.21.4 and picomatch@2.3.1 after both had
# left the actual tree — a finding about a file nobody installs from.
#
# The vulnerability database is a 100 MB+ download shared through the named docker
# volume below, so only the first run on a machine pays for it, and it updates
# itself independently of the pinned image tag: a tree that is clean today can go
# red tomorrow with no commit in between. That is the gate working, not flaking.
#
# Bypass: `SKIP_TRIVY=1 git push` — for a Docker or network outage, never for a
# finding.
# ---------------------------------------------------------------------------

if [ -n "${SKIP_TRIVY:-}" ]; then
	echo 'pre-push [2/6]: dependency-advisory gate skipped — SKIP_TRIVY is set.' >&2
else
	# Same contract as the SAST gate above: a missing prerequisite blocks, it never
	# warns and continues. A gate that steps aside when it cannot run is not a gate.
	trivy_block() {
		local reason="$1"
		shift
		{
			echo
			echo '────────────────────────────────────────────────────────────────────────────'
			echo "PUSH BLOCKED — $reason"
			echo
			echo 'Fix it with:'
			echo
			printf '    %s\n' "$@"
			echo
			echo 'Bypass once (every other gate still runs): SKIP_TRIVY=1 git push'
			echo '────────────────────────────────────────────────────────────────────────────'
		} >&2
		exit 1
	}

	TRIVY_IMAGE='aquasec/trivy:0.70.0'

	# An absent lockfile is not an empty one: trivy would find no language-specific
	# file, report nothing and exit 0, which reads exactly like a clean tree.
	[ -f yarn.lock ] ||
		trivy_block 'yarn.lock is missing from the repo root — the scan would have nothing to read and would pass.' \
			'git checkout yarn.lock'

	command -v docker > /dev/null 2>&1 ||
		trivy_block 'docker not found in PATH — the scan runs inside the pinned trivy container.' \
			'# install Docker Engine, then push again:' \
			'https://docs.docker.com/engine/install/'

	docker info > /dev/null 2>&1 ||
		trivy_block 'docker daemon not reachable.' \
			'sudo systemctl start docker'

	docker image inspect "$TRIVY_IMAGE" > /dev/null 2>&1 ||
		trivy_block "trivy image $TRIVY_IMAGE is not present locally." \
			"docker pull $TRIVY_IMAGE"

	echo "pre-push [2/6]: checking dependency advisories ($TRIVY_IMAGE)…"

	# --db-repository is not a preference: from here mirror.gcr.io answers 404 for
	# the database layer and trivy treats that as fatal rather than falling back to
	# its second source. The mount is read-only — the scan reads the tree and the
	# cache volume, and writes nothing into the repo.
	if ! docker run --rm \
		-v "$PWD":/src:ro \
		-v trivy-db-cache:/root/.cache/trivy \
		"$TRIVY_IMAGE" fs \
		--db-repository ghcr.io/aquasecurity/trivy-db:2 \
		--scanners vuln \
		--skip-dirs node_modules \
		--skip-dirs .stryker-tmp \
		--skip-dirs .qodana \
		--severity HIGH,CRITICAL \
		--exit-code 1 \
		--skip-version-check \
		/src; then
		cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — a HIGH or CRITICAL advisory in the production tree, or the scan
could not run. Both exit 1; the output above says which.

Every finding is printed with its CVE id, the version installed and the version
that fixes it. In order:

  1. Upgrade the dependency. If it is transitive, `yarn why <name>` names the one
     that pulls it in, and that is the one to move.
  2. If the package is only ever loaded by the toolchain, it belongs in
     devDependencies — moving it there is the fix, and the scan stops seeing it.
  3. Only when there is no upgrade path: a `.trivyignore` entry, one line per CVE
     id, with a comment naming the risk-register row that accepted it. Reviewed,
     per finding, dated. Never a --severity edit, never a blanket ignore.
────────────────────────────────────────────────────────────────────────────
MSG
		exit 1
	fi

	echo 'pre-push [2/6]: no HIGH or CRITICAL advisory in the production tree.'
fi

echo "pre-push [3/6]: checking lint and formatting (yarn lint:check)…"

if ! yarn lint:check; then
	cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — eslint or prettier is not clean.

`lint:check` is `yarn lint` without the writes: eslint over the whole tree, then
`prettier --check` over the same — tests, configs and yaml included, not just
src/. Fix it with:

    yarn lint

and commit what it rewrote. Never silence a rule to get a push through: a path
that belongs to neither tool belongs in .prettierignore or in the `ignores`
block of eslint.config.js, with the reason written next to it.
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

echo "pre-push [4/6]: enforcing 100% test coverage (yarn test:cov)…"

if ! yarn test:cov; then
	cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — coverage is below 100%.

Fix it (do NOT lower the thresholds in vitest.config.mts / qodana.yaml):
  1. Add the missing tests for the uncovered lines / branches / functions.
  2. If the uncovered code is unreachable or dead, delete it.
  3. index.mts (server wiring) needs an integration test that boots the server —
     that is where the remaining coverage work, if any, lives.

Re-run `yarn test:cov` until every metric reports 100%, then push again.
Full policy: COVERAGE.md
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

echo "pre-push [5/6]: enforcing 100% mutation score (yarn test:mutation)…"

if ! yarn test:mutation; then
	cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — mutation score is below 100%.

Every surviving mutant is an edit to src/ that no test noticed. Fix it
(do NOT lower `thresholds.break` in stryker.config.mjs):
  1. Open reports/mutation/mutation.html and read each [Survived] mutant.
  2. Strengthen the assertion that should have caught it. A test that only
     checks `rejects.toThrow()` or `toHaveBeenCalled()` passes for every
     possible error/argument — assert the specific one (see the console.debug
     assertion in test/schema.test.mts).
  3. Only if the mutant is provably equivalent — the mutated code cannot behave
     differently on any reachable input — annotate it in src with
     `// Stryker disable next-line <Mutator>: <why>` and write the reachability
     argument in a comment above it.

Re-run `yarn test:mutation` until it reports 100%, then push again.
Full policy: COVERAGE.md
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

# ---------------------------------------------------------------------------
# Gate 5 — Qodana. It runs here as well as in pre-commit, for two reasons that
# pre-commit structurally cannot cover.
#
# 1. `git merge --no-ff` never fires pre-commit. Git runs that hook for
#    `git commit` only, so in the branch → commit → merge → push flow the merge
#    commit — the one revision that actually reaches origin — is the single
#    commit no pre-commit scan ever sees. Two individually clean branches can
#    merge into a tree that is not.
# 2. Qodana Cloud files every report under the branch it was produced on, and
#    pre-commit always runs on the feature branch, before the commit exists. A
#    repo gated only there can never produce a `main`-tagged report, so `main`
#    is not offered as the cloud project's default branch and the "new problems"
#    baseline has nothing stable to compare against. This hook runs after the
#    merge, standing on main, which is exactly the revision the baseline wants.
#
# SKIP_TESTS=1: gate 2 has already written a current coverage/lcov.info, and
# qodana.sh would otherwise re-run the whole suite with `|| true`, swallowing the
# exit code. Reuse the report rather than pay for it twice.
#
# Bypass: `SKIP_QODANA=1 git push` (coverage and mutation still gate).
# ---------------------------------------------------------------------------

if [ -n "${SKIP_QODANA:-}" ]; then
	echo 'pre-push: Qodana gate skipped — SKIP_QODANA is set.' >&2
	exit 0
fi

# $1 = what is wrong, $2… = the command(s) that fix it. A missing prerequisite
# blocks; it never warns and continues. A gate that steps aside when it cannot
# run is not a gate, it is the hole this hook exists to close, reopened one
# condition lower.
push_block() {
	local reason="$1"
	shift
	{
		echo
		echo '────────────────────────────────────────────────────────────────────────────'
		echo "PUSH BLOCKED — $reason"
		echo
		echo 'Fix it with:'
		echo
		printf '    %s\n' "$@"
		echo
		echo 'Bypass once (coverage and mutation still gate): SKIP_QODANA=1 git push'
		echo '────────────────────────────────────────────────────────────────────────────'
	} >&2
	exit 1
}

command -v qodana > /dev/null 2>&1 ||
	push_block 'the qodana CLI is not in PATH.' \
		'# install it, then push again:' \
		'https://github.com/JetBrains/qodana-cli#installation'

command -v docker > /dev/null 2>&1 ||
	push_block 'docker not found in PATH — the CLI runs the linter in a container.' \
		'# install Docker Engine, then push again:' \
		'https://docs.docker.com/engine/install/'

docker info > /dev/null 2>&1 ||
	push_block 'docker daemon not reachable.' \
		'sudo systemctl start docker'

for required in qodana.yaml qodana.sh; do
	[ -f "$required" ] ||
		push_block "$required missing from the repo root." \
			"git checkout $required"
done

# Track the image declared in qodana.yaml rather than hard-coding a tag here, so
# bumping the version in one place cannot leave the hook scanning with an older
# linter than the manual runs use.
LINTER="$(grep -oE 'jetbrains/qodana-js:[0-9][0-9.]*' qodana.yaml | head -n 1 || true)"

[ -n "$LINTER" ] ||
	push_block "no 'jetbrains/qodana-js:<version>' image line found in qodana.yaml." \
		'# restore the `image:` key, then push again:' \
		'git checkout qodana.yaml'

# The CLI would pull this itself. Blocking instead keeps a slow or unreachable
# Docker Hub from turning into a failed push: one explicit pull per image bump,
# versus a network flake on any push.
docker image inspect "$LINTER" > /dev/null 2>&1 ||
	push_block "linter image $LINTER not present locally." \
		"docker pull $LINTER"

# Metadata check only — the value is never read here. qodana.sh loads the token
# into the process env without printing it.
{ [ -f ".env" ] && grep -q '^[[:space:]]*QODANA_TOKEN=' ".env"; } ||
	push_block "no QODANA_TOKEN in .env — Qodana 2023.2+ refuses to start without it." \
		'# get a project token from https://qodana.cloud, then:' \
		"echo 'QODANA_TOKEN=<token>' >> .env"

echo "pre-push [6/6]: enforcing the Qodana gate ($LINTER)…"

if ! SKIP_TESTS=1 ./qodana.sh --results-dir .qodana/results; then
	cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — Qodana failed.

The gate lives in qodana.yaml: testCoverageThresholds 100 total / 100 fresh,
plus the third-party license audit. The vulnerable-dependency inspection it also
runs is the offline heuristic E18-S11 measured at zero — the real check is the
trivy gate above.
Findings are listed above, with a report link on qodana.cloud.

Local SARIF: .qodana/results/qodana.sarif.json

This exit code also covers infrastructure failures (daemon died mid-scan, out
of disk). If the report shows no findings, it was not a finding.

Bypass once (coverage and mutation still gate): SKIP_QODANA=1 git push
────────────────────────────────────────────────────────────────────────────
MSG
	exit 1
fi

echo 'pre-push: Qodana clean. Pushing.'
